rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Profile photos - users can only manage their own photos
    match /profile-photos/{userId}/{allPaths=**} {
      allow read: if true; // Public read for marketplace
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Item photos - sellers can manage their own item photos
    match /item-photos/{itemId}/{allPaths=**} {
      allow read: if true; // Public read for marketplace
      allow write: if request.auth != null; // Must be authenticated to upload
    }
    
    // Unsplash and seeded demo images - read only
    match /demo-images/{allPaths=**} {
      allow read: if true;
    }
    
    // Default: authenticated users can read all images for marketplace functionality
    match /{allPaths=**} {
      allow read: if true; // Public read for marketplace images
      allow write: if false; // Deny all other writes
    }
  }
}