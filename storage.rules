rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // TEMPORARY: Allow unauthenticated uploads for testing
    // TODO: Enable proper authentication before production
    match /profile-photos/{userId}/{allPaths=**} {
      allow read, write: if true; // Temporary open access for testing
    }
    
    // Item photos - temporarily allow unauthenticated uploads
    match /item-photos/{itemId}/{allPaths=**} {
      allow read, write: if true; // Temporary open access for testing
    }
    
    // Test images for Firebase integration testing
    match /test-images/{allPaths=**} {
      allow read, write: if true;
    }
    
    // Allow reading all images for marketplace functionality
    match /{allPaths=**} {
      allow read: if true; // Temporary open read access
    }
  }
}