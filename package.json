{
  "name": "swipecity-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@swipecity/web",
    "dev:mobile": "npm run start --workspace=@swipecity/mobile",
    "build:web": "npm run build --workspace=@swipecity/web",
    "build:mobile": "npm run build --workspace=@swipecity/mobile",
    "build:packages": "npm run build --workspace=@swipecity/shared && npm run build --workspace=@swipecity/firebase && npm run build --workspace=@swipecity/ui",
    "build:all": "npm run build:packages && npm run build:web && npm run build:mobile",
    "lint": "npm run lint --workspace=@swipecity/web",
    "test": "npm run test --workspace=@swipecity/web",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules"
  },
  "devDependencies": {
    "prettier": "^3.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/cli": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capacitor/ios": "^7.4.3"
  }
}
