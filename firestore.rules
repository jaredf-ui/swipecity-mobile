rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read/write their own user document; read others for the marketplace.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null;
    }

    // Items/Listings.
    // NOTE: create/update must validate request.resource.data (the incoming doc).
    // The previous rules checked resource.data on create, where `resource` is null,
    // so every create was denied — which is why cross-device listings never worked.
    match /items/{itemId} {
      // Everyone signed in can read active items; a seller can also read their
      // own listings regardless of status (so "My Listings" shows sold items).
      allow read: if request.auth != null &&
                  (resource.data.status == 'active' ||
                   request.auth.uid == resource.data.seller_id);
      allow create: if request.auth != null &&
                    request.auth.uid == request.resource.data.seller_id;
      allow update, delete: if request.auth != null &&
                    request.auth.uid == resource.data.seller_id;
    }

    // Interests/Matches.
    match /interests/{interestId} {
      allow read: if request.auth != null &&
                  (request.auth.uid == resource.data.buyer_id ||
                   request.auth.uid == resource.data.seller_id);
      allow create: if request.auth != null &&
                    request.auth.uid == request.resource.data.buyer_id;
      // The seller may accept/reject — change ONLY the status field, nothing else.
      allow update: if request.auth != null &&
                    request.auth.uid == resource.data.seller_id &&
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
    }

    // Reports - users can create reports.
    match /reports/{reportId} {
      allow create: if request.auth != null &&
                    request.auth.uid == request.resource.data.reporter_id;
    }

    // Chats. Splitting create from write is required: the old single `write` rule
    // checked resource.data.participants, but on first create `resource` is null,
    // so no chat could ever be created.
    match /chats/{chatId} {
      allow create: if request.auth != null &&
                    request.auth.uid in request.resource.data.participants;
      allow read, update: if request.auth != null &&
                          request.auth.uid in resource.data.participants;
    }

    match /chats/{chatId}/messages/{messageId} {
      allow read, create: if request.auth != null &&
                          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }
  }
}
